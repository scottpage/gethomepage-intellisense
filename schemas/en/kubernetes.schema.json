{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gethomepage.dev/schemas/kubernetes.schema.json",
  "title": "GetHomepage Kubernetes Configuration",
  "description": "Configuration for Kubernetes. Documentation: https://gethomepage.dev/configs/kubernetes/",
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "description": "Configuration for Mode.",
      "enum": [
        "disabled",
        "default",
        "cluster"
      ],
      "default": "default"
    },
    "ingress": {
      "type": "boolean",
      "description": "Configuration for Ingress.",
      "default": true
    },
    "traefik": {
      "type": "boolean",
      "description": "Configuration for Traefik.",
      "default": false
    },
    "gateway": {
      "type": "boolean",
      "description": "Configuration for Gateway.",
      "default": false
    }
  },
  "additionalProperties": false
}
